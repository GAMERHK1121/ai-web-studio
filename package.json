{
  "name": "ai-web-studio-ultimate",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:client\" \"npm:server\"",
    "client": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "express": "latest",
    "cors": "latest",
    "uuid": "latest",
    "concurrently": "latest",
    "three": "latest",
    "gsap": "latest",
    "archiver": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "wrangler": "latest"
  },
  "type": "module",
  "version": "3.0.0"
}
